generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

enum DocumentType {
  INVOICE
  PROFORMA
  CREDIT_NOTE
  DEBIT_NOTE
  QUOTE
  DELIVERY_NOTE
}

enum DocumentStatus {
  DRAFT
  SENT
  PAID
  CANCELLED
}

enum SubscriptionStatus {
  TRIALING
  ACTIVE
  PAST_DUE
  CANCELED
}

enum VatCategory {
  S
  Z
  E
  AE
  K
  G
  O
}

enum EinvoiceTransmissionStatus {
  QUEUED
  SENT
  DELIVERED
  REJECTED
  PENDING
  ACCEPTED
}

model Account {
  id                 String   @id @default(cuid())
  creditBalanceCents Int      @default(0)
  createdAt          DateTime @default(now())
  updatedAt          DateTime @updatedAt

  users          User[]
  issuerProfile  IssuerProfile?
  clients        Client[]
  catalogueItems CatalogueItem[]
  numberSeries   NumberSeries[]
  documents      Document[]
  subscription   Subscription?
  creditLedger   CreditLedgerEntry[]

  @@map("account")
}

model User {
  id            String   @id
  name          String
  email         String   @unique
  emailVerified Boolean  @default(false)
  image         String?
  role          String   @default("user")
  locale        String   @default("bg")
  country       String?
  accountId     String
  account       Account  @relation(fields: [accountId], references: [id], onDelete: Cascade)
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt

  sessions     Session[]
  authAccounts AuthAccount[]

  @@index([accountId])
  @@map("user")
}

model Session {
  id        String   @id
  expiresAt DateTime
  token     String   @unique
  ipAddress String?
  userAgent String?
  userId    String
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([userId])
  @@map("session")
}

model AuthAccount {
  id                    String    @id
  accountId             String
  providerId            String
  userId                String
  user                  User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  accessToken           String?
  refreshToken          String?
  idToken               String?
  accessTokenExpiresAt  DateTime?
  refreshTokenExpiresAt DateTime?
  scope                 String?
  password              String?
  createdAt             DateTime  @default(now())
  updatedAt             DateTime  @updatedAt

  @@index([userId])
  @@map("auth_account")
}

model Verification {
  id         String   @id
  identifier String
  value      String
  expiresAt  DateTime
  createdAt  DateTime @default(now())
  updatedAt  DateTime @updatedAt

  @@map("verification")
}

model IssuerProfile {
  id               String   @id @default(cuid())
  accountId        String   @unique
  account          Account  @relation(fields: [accountId], references: [id], onDelete: Cascade)
  companyName      String?
  eik              String?
  mol              String?
  addressLine      String?
  street           String?
  postcode         String?
  countyRegion     String?
  city             String?
  country          String   @default("BG")
  phone            String?
  vatRegistered    Boolean  @default(false)
  vatNumber        String?
  bankName         String?
  iban             String?
  bic              String?
  altIban          String?
  peppolEndpointId String?
  peppolScheme     String?
  identifiers      Json?
  vatOnCashBasis   Boolean  @default(false)
  vatOnDebits      Boolean  @default(false)
  createdAt        DateTime @default(now())
  updatedAt        DateTime @updatedAt

  @@map("issuer_profile")
}

model Client {
  id               String   @id @default(cuid())
  accountId        String
  account          Account  @relation(fields: [accountId], references: [id], onDelete: Cascade)
  companyName      String
  eik              String?
  vatNumber        String?
  address          String?
  street           String?
  postcode         String?
  countyRegion     String?
  city             String?
  country          String   @default("BG")
  documentLanguage String?
  email            String?
  mol              String?
  peppolEndpointId String?
  peppolScheme     String?
  sdiRecipientCode String?
  pec              String?
  createdAt        DateTime @default(now())
  updatedAt        DateTime @updatedAt

  documents Document[]

  @@unique([accountId, eik])
  @@index([accountId])
  @@map("client")
}

model CatalogueItem {
  id               String   @id @default(cuid())
  accountId        String
  account          Account  @relation(fields: [accountId], references: [id], onDelete: Cascade)
  name             String
  defaultUnitPrice Int
  unit             String
  unitCode         String?
  createdAt        DateTime @default(now())
  updatedAt        DateTime @updatedAt

  @@index([accountId])
  @@map("catalogue_item")
}

model NumberSeries {
  id           String       @id @default(cuid())
  accountId    String
  account      Account      @relation(fields: [accountId], references: [id], onDelete: Cascade)
  documentType DocumentType
  nextNumber   BigInt       @default(1)
  issuedCount  Int          @default(0)
  createdAt    DateTime     @default(now())
  updatedAt    DateTime     @updatedAt

  @@unique([accountId, documentType])
  @@map("number_series")
}

model Document {
  id           String         @id @default(cuid())
  accountId    String
  account      Account        @relation(fields: [accountId], references: [id], onDelete: Restrict)
  documentType DocumentType
  status       DocumentStatus @default(DRAFT)

  number             BigInt?
  numberPrefix       String?
  numberSuffix       String?
  referenceNumber    String?
  originalDocumentId String?
  originalDocument   Document?  @relation("DocumentCorrections", fields: [originalDocumentId], references: [id], onDelete: Restrict)
  corrections        Document[] @relation("DocumentCorrections")
  // credit_note/debit_note only: reason for issuing the correction (BG ЗДДС
  // чл. 115, ал. 4, т. 2; IE VAT Regulations 2010 Reg. 20; ES RD 1619/2012
  // art. 15), required at issuance for BG/IE/ES issuers, optional elsewhere.
  correctionReason String?

  // PL only: the KSeF number the user pastes back in after uploading the FA(3)
  // XML to KSeF themselves (fakturcho never submits it). Printed under the
  // KOD I QR code once set; the invoice shows "OFFLINE" until then.
  ksefNumber String?

  issuedAt     DateTime? @db.Date
  taxEventAt   DateTime? @db.Date
  dueAt        DateTime? @db.Date
  validUntil   DateTime? @db.Date
  deliveryDate DateTime? @db.Date

  buyerReference   String?
  paymentMeansCode String?
  paymentTermsNote String?

  // delivery_note only: IT DDT causale del trasporto / RO aviz scop, and its
  // date+time of dispatch (DPR 472/1996 art.1 requires date AND time, unlike
  // every other document's date-only fields).
  transportReason String?
  transportedAt   DateTime?
  carrierName     String?
  transportNote   String?

  // CGI art. 242 nonies A (French e-invoicing reform): nature of the
  // operation ("goods" | "services" | "mixed") and, when it differs from the
  // client address, the delivery address of goods.
  operationNature  String?
  deliveryAddress  String?

  subtotal           Int     @default(0)
  discountTotal      Int     @default(0)
  amount             Int     @default(0)
  vatIncluded        Boolean @default(false)
  vatRateBp          Int     @default(2000)
  vatAmount          Int     @default(0)
  vatExemptionGround String?
  currency           String  @default("EUR")

  // VAT Directive art. 230 snapshot, set at issuance for issuers in a
  // non-euro EU_VAT_AREA_COUNTRIES state. Null for drafts, euro-area
  // issuers, and documents issued before this column existed.
  localCurrency      String?
  exchangeRate       String?
  exchangeRateDate   DateTime? @db.Date
  exchangeRateSource String?
  exchangeRateTable  String?
  vatAmountLocal     Int?

  clientId String?
  client   Client? @relation(fields: [clientId], references: [id], onDelete: SetNull)

  preparedBy String?
  notes      String?
  emailText  String?
  emailedAt  DateTime?
  templateId String    @default("classic")

  issuerCompanyName    String?
  issuerEik            String?
  issuerMol            String?
  issuerAddressLine    String?
  issuerStreet         String?
  issuerPostcode       String?
  issuerCountyRegion   String?
  issuerCity           String?
  issuerCountry        String?
  issuerPhone          String?
  issuerVatRegistered  Boolean?
  issuerVatNumber      String?
  issuerBankName       String?
  issuerIban           String?
  issuerBic            String?
  issuerAltIban        String?
  issuerIdentifiers    Json?
  issuerVatOnCashBasis Boolean?
  issuerVatOnDebits    Boolean?

  recipientCompanyName      String?
  recipientEik              String?
  recipientVatNumber        String?
  recipientAddress          String?
  recipientStreet           String?
  recipientPostcode         String?
  recipientCountyRegion     String?
  recipientCity             String?
  recipientCountry          String?
  recipientEmail            String?
  recipientMol              String?
  recipientSdiRecipientCode String?
  recipientPec              String?
  documentLanguage          String?

  lineItems            LineItem[]
  discounts            Discount[]
  creditLedgerEntry    CreditLedgerEntry?
  einvoiceTransmission EinvoiceTransmission?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@unique([accountId, documentType, number])
  @@index([accountId, status])
  @@index([accountId, createdAt])
  @@index([originalDocumentId])
  @@map("document")
}

model LineItem {
  id          String      @id @default(cuid())
  documentId  String
  document    Document    @relation(fields: [documentId], references: [id], onDelete: Cascade)
  name        String
  quantity    Decimal     @db.Decimal(14, 3)
  unitPrice   Int
  lineTotal   Int
  sortOrder   Int
  vatRateBp   Int         @default(2000)
  vatCategory VatCategory @default(S)
  unitCode    String?

  @@index([documentId])
  @@map("line_item")
}

model Discount {
  id         String   @id @default(cuid())
  documentId String
  document   Document @relation(fields: [documentId], references: [id], onDelete: Cascade)
  label      String
  percentBp  Int?
  amount     Int?
  sortOrder  Int      @default(0)

  @@index([documentId])
  @@map("discount")
}

model Subscription {
  id                    String             @id @default(cuid())
  accountId             String             @unique
  account               Account            @relation(fields: [accountId], references: [id], onDelete: Cascade)
  status                SubscriptionStatus @default(TRIALING)
  revolutSubscriptionId String?            @unique
  revolutCustomerId     String?
  revolutSetupOrderId   String?
  checkoutUrl           String?
  checkoutStartedAt     DateTime?
  planId                String?
  currentPeriodEnd      DateTime?
  // a paid plan being upgraded keeps running until the new tier is actually paid;
  // these track that in-flight Revolut subscription without touching the fields above
  pendingPlanId                String?
  pendingRevolutSubscriptionId String?   @unique
  pendingRevolutSetupOrderId   String?
  pendingCheckoutUrl           String?
  pendingCheckoutStartedAt     DateTime?
  createdAt             DateTime           @default(now())
  updatedAt             DateTime           @updatedAt

  @@map("subscription")
}

enum CreditLedgerReason {
  SIGNUP_GRANT
  SUBSCRIPTION_GRANT
  PURCHASE
  ISSUANCE
  ADJUSTMENT
}

model CreditLedgerEntry {
  id             String             @id @default(cuid())
  accountId      String
  account        Account            @relation(fields: [accountId], references: [id], onDelete: Cascade)
  amountCents    Int
  reason         CreditLedgerReason
  documentId     String?            @unique
  document       Document?          @relation(fields: [documentId], references: [id], onDelete: SetNull)
  revolutOrderId String?            @unique
  createdAt      DateTime           @default(now())

  @@index([accountId, createdAt])
  @@map("credit_ledger_entry")
}

model EinvoiceTransmission {
  id                String                     @id @default(cuid())
  documentId        String                     @unique
  document          Document                   @relation(fields: [documentId], references: [id], onDelete: Cascade)
  status            EinvoiceTransmissionStatus @default(QUEUED)
  provider          String
  providerMessageId String?
  receipt           String?
  errorText         String?
  retryCount        Int                        @default(0)
  createdAt         DateTime                   @default(now())
  updatedAt         DateTime                   @updatedAt

  @@index([status])
  @@map("einvoice_transmission")
}

model FeatureFlag {
  key       String   @id
  enabled   Boolean  @default(false)
  updatedAt DateTime @updatedAt

  @@map("feature_flag")
}

model EsVerifactuChainLink {
  id              String   @id @default(cuid())
  issuerNif       String   @unique
  numSerieFactura String
  fechaExpedicion String
  huella          String
  updatedAt       DateTime @updatedAt

  @@map("es_verifactu_chain_link")
}
